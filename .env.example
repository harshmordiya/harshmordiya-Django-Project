# Django Secret Key (generate a secure random 50+ character string in production)
SECRET_KEY=your-secret-key-here

# Debug Mode (set to False in production)
DEBUG=True

# Email Configuration (SMTP / Gmail)
# If left blank, Django falls back to the console email backend for local testing
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Razorpay Payment Gateway Credentials
# Obtain test/production keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
